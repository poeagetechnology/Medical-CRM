# Copy this file to .env.local for local development.
# On Vercel: Project -> Settings -> Environment Variables (add each name below).
# Values come from Firebase Console -> Project settings -> Your apps -> SDK setup.
# NOTE: Create React App only exposes variables prefixed with REACT_APP_ and
# inlines them at BUILD time, so redeploy after changing them on Vercel.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
# Optional (Google Analytics)
REACT_APP_FIREBASE_MEASUREMENT_ID=
